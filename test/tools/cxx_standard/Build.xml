<xml>
	<files id="test" cxx_standard="17">
		<compilerflag value="/Zc:__cplusplus" if="isMsvc" />
		<file name="main.cpp" />
		<file name="cxx14.cpp" cxx_standard="14" />
		<file name="c11.c" c_standard="11" />
		<file name="c17.c" c_standard="17" />
	</files>

	<files id="objc_test" cxx_standard="14" c_standard="17">
		<!-- should fall back to c++ std if no objc++ standard is given -->
		<file name="objcxx14.mm" />
		<file name="objcxx11.mm" objcxx_standard="11" />
		<!-- should fall back to c std if no objc standard is given -->
		<file name="objc17.m" />
		<file name="objc11.m" objc_standard="11" />
	</files>

	<set name="EXESUFFIX" value=".exe" if="windows" />

	<target id="default" tool="linker" toolid="exe" output="main${EXESUFFIX}">
		<files id="test"/>
		<files id="objc_test" if="macos" />
	</target>
</xml>
